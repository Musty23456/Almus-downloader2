<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the link check (HEAD/GET of headers) before a download is queued. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: runtime permission, asked only when the user starts a download. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lets the app re-check its download queue after the phone restarts, so queued downloads
      continue. Normal permission, granted automatically at install.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      New download engine: a foreground service of type dataSync keeps downloads alive in the background
      (Android 14+ needs the specific permission), and the connection state lets it wait for a network
      or for Wi-Fi. All three are normal permissions granted at install.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Android 9 and older only: needed to write into the public Downloads folder.
      Android 10+ uses scoped storage and needs no storage permission at all.
      If the user declines on Android 9 or older, files go to the app's own folder.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />


    <application
        android:name=".AlmusApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlmusDownloader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AlmusDownloader"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The system sends this broadcast when a download finishes. It must be exported
          so the system can deliver it; the receiver ignores any id that is not in the
          app's own download table.
        -->
        <receiver
            android:name=".download.DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- After a restart: reconcile records with the system and continue the queue. -->
        <receiver
            android:name=".download.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          New download engine. Not exported: only the app itself can start the service or press the
          notification buttons. The service type is dataSync (file transfer).
        -->
        <service
            android:name=".engine.android.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps yt-dlp downloads running while the app is in the background. -->
        <service
            android:name=".ytdlp.YtDlpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".engine.android.EngineActionReceiver"
            android:exported="false" />

    </application>

</manifest>
